*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binaries/data
*.exe  binary
*.dll  binary
*.so   binary
*.dylib binary
*.o    binary
*.a    binary
*.zip  binary
*.tar  binary
*.gz   binary
*.dat  binary
*.db   binary

# Fallback
* text=auto
